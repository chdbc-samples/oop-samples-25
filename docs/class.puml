classDiagram
  class BonusEligible {
    <<interface>>
    +double DEFAULT_BONUS
    +getBonus() double
    +setBonus(double bonus) void
  }

  class Person {
    <<Abstract>>
    -String name
    +Person()
    +Person(String name)
    +getName() String
    +setName(String name) void
    +displayInfo() void
    +getFullDetails() String
    +printInfo(Person person) void
  }

  class Employee {
    -double bonus
    +Employee()
    +Employee(String name)
    +Employee(String name, double bonus)
    +getBonus() double
    +setBonus(double bonus) void
    +displayInfo() void
  }

  class Paycheck {
    +double amount
    +String payDate
    +Paycheck(double amount, String payDate)
    +getAmount() double
    +getPayDate() String
    +displayPaycheckInfo() void
  }

  class Payroll {
    -List[Person] employees
    -Paycheck paycheck
    -PaymentService paymentService
    +Payroll(PaymentService paymentService)
    +setEmployees(List[Person] employees) void
    +processPayroll(double salary) void
  }

  class PaymentService {
    -Connection connection
    +PaymentService(Connection connection)
    +savePaycheck(Paycheck paycheck) void
    +getConnection() Connection
  }

  class Connection {
    <<JDBC Interface>>
  }

  class SQLiteDriver {
    <<JDBC Driver>>
  }

  class PayrollModule {
    <<Guice Module>>
    +configure() void
    +provideConnection(String url) Connection
  }

  BonusEligible <|.. Employee : implements
  Person <|-- Employee : extends
  Payroll o-- Person : aggregates
  Payroll *-- Paycheck : composition
